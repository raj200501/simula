# Copy this file to .env and fill in ONE key. .env is git-ignored: never commit keys.
#
# Free option: Google AI Studio key (https://aistudio.google.com/apikey). Uses Gemini Flash models.
GEMINI_API_KEY=
# Paid option: Anthropic key (https://console.anthropic.com). Uses Claude.
# ANTHROPIC_API_KEY=
#
# Optional overrides
# SIMULA_PROVIDER=gemini                 # or anthropic (auto-detected from whichever key is set)
# SIMULA_MODEL=gemini-3.8-flash          # generation, proposals, judging
# SIMULA_MODEL_FAST=gemini-3.5-flash-lite  # per-screen annotator (high volume)
# SIMULA_MODEL_FALLBACKS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-3.1-flash-lite  # tried in order when a model is busy (503) or out of its daily
#                                        # free quota (~20 requests/day per Flash model); Flash-Lite is always the last resort
# SIMULA_RPM=9                           # max requests/minute per model (free tier is rate limited)
# SIMULA_BUDGET_USD=150                  # hard spend cap (paid keys only)
# ANDROID_HOME=                          # if the Android SDK is not in ~/Library/Android/sdk
# ANDROID_SERIAL=emulator-5554           # when more than one device is connected
