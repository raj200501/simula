# Required for live runs (stages that call Claude). Not needed for `npm run demo` or `--llm replay`.
ANTHROPIC_API_KEY=
# Optional model overrides (defaults: claude-opus-5 for everything)
# SIMULA_MODEL=claude-opus-5
# SIMULA_MODEL_FAST=claude-opus-5      # per-new-screen annotator; claude-sonnet-5 is ~2.5x cheaper
# Hard spend cap across all stages (USD)
SIMULA_BUDGET_USD=150
# Android SDK location if not ~/Library/Android/sdk
# ANDROID_HOME=
# Pick a device when more than one is online
# ANDROID_SERIAL=emulator-5554
